{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "types": ["jquery", "node", "oojs", "oojs-ui"],
    "module": "preserve",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true,
    "noEmit": true,                                   /* Disable emitting files from a compilation. (I'm using esbuild for build.) */
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, 
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": [
    "build.mjs",
    "src",
    "tests",
    "./node_modules/types-mediawiki"
  ]
}
